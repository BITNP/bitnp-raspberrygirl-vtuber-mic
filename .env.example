# This is a production/LAN template. Load a local copy explicitly with
# `uv run --env-file .env ...`; the application does not load .env files itself.
# Production control must use the deployed Orchestrator WSS endpoint.
ORCHESTRATOR_WS_URL=wss://orchestrator.example.test/control
# OpenAI-compatible ASR service base URL. Mic appends /audio/transcriptions.
MIC_ASR_ENDPOINT=https://asr.example.test/v1
MIC_ASR_MODEL=<openai-compatible-asr-model>
# Optional. Leave blank when the ASR server has no bearer auth.
MIC_ASR_API_KEY=
# CAM++、ZipEnhancer 和 Silero VAD ONNX 模型及 CAM++ FBank 配置已随 Mic
# 安装包分发并自动加载，无需在此配置模型路径或 revision。
# ZipEnhancer 持续增强 16 kHz mono PCM16，再送入 Silero VAD、CAM++ 和 ASR。
# Duration of each independent ZipEnhancer window. Must be a multiple of 20;
# 500 ms is the low-latency default supported by the continuous pipeline.
MIC_ZIPENHANCER_WINDOW_MS=500
# 内置 Silero VAD 使用 `input`、`state`、`sr` 官方 ONNX 契约进行本地端点检测。
MIC_ASR_ENDPOINT_INCLUDES_VAD=false
# Mount the shared PEM CA bundle read-only so Mic verifies the Orchestrator WSS certificate.
ORCHESTRATOR_TLS_CA_PATH=/run/secrets/internal-ca-bundle.pem
# Set this only from deployment secret storage. Do not commit a bearer token.
TRUSTED_LAN_TOKEN=<set-from-deployment-secret-store>
# Keep false in production. For local loopback, use ws://localhost:8443/control,
# set this to true, and leave TRUSTED_LAN_TOKEN empty because the loopback
# Orchestrator rejects Authorization headers.
MIC_ALLOW_LOOPBACK_WS=false
# Leave empty for continuous capture. Set a positive integer only for a bounded run.
MIC_MAX_CAPTURE_BLOCKS=
# Omit or use default for the host default input. An index or device-name query is also accepted.
BITNP_CAPTURE_DEVICE=default
# Values supplied with each Mic stream registration.
# Mic input identity; no Mic RTP stream or UDP endpoint is configured.
BITNP_MIC_RTP_STREAM_ID=onsite-primary
BITNP_MIC_RTP_TIMESTAMP=0
BITNP_TRACE_ID=trace-mic-001
BITNP_SESSION_ID=session-onsite-001
# Used by mic-health.
SERVICE_HEALTH_HOST=127.0.0.1
SERVICE_HEALTH_PORT=8010
