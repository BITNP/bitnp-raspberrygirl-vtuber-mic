# Production control must use the deployed Orchestrator WSS endpoint.
ORCHESTRATOR_WS_URL=wss://orchestrator.example.test/control
# Mount the shared PEM CA bundle read-only so Mic verifies the Orchestrator WSS certificate.
ORCHESTRATOR_TLS_CA_PATH=/run/secrets/internal-ca-bundle.pem
# Set this only from deployment secret storage. Do not commit a bearer token.
TRUSTED_LAN_TOKEN=<set-from-deployment-secret-store>
# UDP RTP ingress owned by Orchestrator.
ORCHESTRATOR_RTP_HOST=orchestrator.example.test
ORCHESTRATOR_RTP_PORT=5004
# Local UDP bind. Port 0 selects an ephemeral port.
MIC_RTP_BIND_HOST=0.0.0.0
MIC_RTP_BIND_PORT=0
# Keep false in production. true permits ws:// only for explicit loopback tests.
MIC_ALLOW_LOOPBACK_WS=false
# Leave empty for continuous capture. Set a positive integer only for a bounded run.
MIC_MAX_CAPTURE_BLOCKS=
# Omit or use default for the host default input. An index or device-name query is also accepted.
BITNP_CAPTURE_DEVICE=default
# Values supplied with each Mic stream registration.
BITNP_MIC_RTP_STREAM_ID=onsite-primary
BITNP_MIC_RTP_TIMESTAMP=0
BITNP_TRACE_ID=trace-mic-001
BITNP_SESSION_ID=session-onsite-001
# Used by mic-health.
SERVICE_HEALTH_HOST=127.0.0.1
SERVICE_HEALTH_PORT=8010
